{
  "name": "dsh-voice-mode",
  "description": "dsh-pager three-mode voice extension; maintained derivative of dsh-voice-mode",
  "icon": "./icon.svg",
  "version": "0.7.23-pager.1",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wg5759/dsh-pager.git",
    "directory": "voice-extension"
  },
  "homepage": "https://github.com/wg5759/dsh-pager/blob/main/docs/voice.md",
  "bugs": {
    "url": "https://github.com/wg5759/dsh-pager/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.1-rc.2"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-cordis-client-runner",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "sherpa-onnx": "1.13.8",
    "sherpa-onnx-node": "1.13.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "voice",
    "voice-mode",
    "speech",
    "asr",
    "tts",
    "speech-to-text",
    "text-to-speech",
    "speech-recognition",
    "full-duplex",
    "duplex",
    "barge-in",
    "captions",
    "wake-word",
    "local-asr",
    "on-device",
    "zipformer2",
    "sensevoice",
    "kokoro",
    "msedge-tts",
    "chinese",
    "语音",
    "字幕",
    "打断",
    "中文",
    "本地识别"
  ],
  "license": "MIT",
  "private": true
}
