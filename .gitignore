# Signing key and its password. Never commit: every update must be signed with
# the same key, and whoever holds it can ship "updates" to your phone.
android/keystore/
*.jks
*.keystore

# Private build settings (preset server address, local SDK paths)
android/local.properties

# Build outputs
android/out/
android/.build-download/
android/test/classes-download/

node_modules/
plugin/.cache/
market-host/receipts/
*.log
.DS_Store
Thumbs.db

# Private runtime state and local investigation artifacts (never release).
**/data/
**/receipts/
**/.cache/
*.bak*
*.tmp
.env
.env.*
!.env.example
*credentials*.yaml
*credentials*.json
*.p12
*.pfx
.test-output/
release-local/
